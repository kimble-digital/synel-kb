---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, getArticles, categorySlug, CATEGORY_META } from '../lib/articles.js';
import { icon } from '../lib/icons.js';

const categories = await getCategories();
const articles = await getArticles();
const total = articles.length;
---

<BaseLayout title="Synel Knowledge Base" description="Search Synel setup guides, troubleshooting and how-tos.">
  <section class="kb-hero" id="search">
    <div class="kb-container">
      <p class="kb-hero__eyebrow">Synel Support</p>
      <h1 class="kb-hero__title">How can we help?</h1>
      <p class="kb-hero__sub">Search {total} guides across Synel time &amp; attendance, access control, biometrics, terminals and integrations.</p>

      <div class="kb-search" id="kb-search">
        <input
          id="kb-search-input"
          class="kb-search__input"
          type="search"
          autocomplete="off"
          placeholder="Search for a device, error or how-to…"
          aria-label="Search the knowledge base"
          role="combobox"
          aria-expanded="false"
          aria-controls="kb-search-results"
        />
        <div id="kb-search-results" class="kb-search__results" role="listbox" aria-label="Search results"></div>
      </div>
    </div>
  </section>

  <section class="kb-section kb-container" id="categories">
    <div class="kb-section__head">
      <h2 class="kb-section__title">Browse by category</h2>
      <p class="kb-section__sub">{categories.length} categories · {total} articles</p>
    </div>
    <div class="kb-grid">
      {categories.map(c => {
        const slug = categorySlug(c.name);
        const hue = (CATEGORY_META[c.name] || {}).hue || 'var(--c-navy)';
        return (
          <a class="kb-card" href={`/category/${slug}/`}>
            <span class="kb-icon" style={`background:${hue}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon(slug)} />
            </span>
            <span class="kb-card__body">
              <span class="kb-card__title">{c.name}</span>
              <span class="kb-card__meta">{c.count} article{c.count === 1 ? '' : 's'}</span>
            </span>
            <svg class="kb-card__arrow" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        );
      })}
    </div>
  </section>

  <script>
    const input = document.getElementById('kb-search-input');
    const box = document.getElementById('kb-search-results');
    let fuse = null, data = [], active = -1, ready = false;

    function esc(s){ return s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
    function highlight(text, q){
      if(!q) return esc(text);
      const i = text.toLowerCase().indexOf(q.toLowerCase());
      if(i === -1) return esc(text);
      return esc(text.slice(0,i)) + '<mark>' + esc(text.slice(i, i+q.length)) + '</mark>' + esc(text.slice(i+q.length));
    }

    async function ensure(){
      if(ready) return;
      const [{ default: Fuse }, res] = await Promise.all([
        import('https://esm.sh/fuse.js@7.0.0'),
        fetch('/search-index.json'),
      ]);
      data = await res.json();
      fuse = new Fuse(data, {
        includeScore: true, threshold: 0.38, ignoreLocation: true, minMatchCharLength: 2,
        keys: [{ name: 'title', weight: 0.6 }, { name: 'category', weight: 0.15 }, { name: 'text', weight: 0.25 }],
      });
      ready = true;
    }

    function render(results, q){
      if(!results.length){
        box.innerHTML = '<div class="kb-search__empty">No matches for “' + esc(q) + '”. Try a device name or error message.</div>';
        box.classList.add('is-open'); input.setAttribute('aria-expanded','true'); return;
      }
      box.innerHTML = results.slice(0,8).map((r,idx) => {
        const a = r.item;
        return '<a class="kb-result" role="option" id="kb-opt-'+idx+'" href="'+a.url+'">'
          + '<div class="kb-result__cat">'+esc(a.category)+'</div>'
          + '<div class="kb-result__title">'+highlight(a.title,q)+'</div>'
          + '<div class="kb-result__excerpt">'+esc(a.excerpt)+'</div>'
          + '</a>';
      }).join('');
      box.classList.add('is-open'); input.setAttribute('aria-expanded','true'); active = -1;
    }

    async function onInput(){
      const q = input.value.trim();
      if(q.length < 2){ box.classList.remove('is-open'); input.setAttribute('aria-expanded','false'); return; }
      await ensure();
      render(fuse.search(q), q);
    }

    function move(d){
      const opts = [...box.querySelectorAll('.kb-result')];
      if(!opts.length) return;
      active = (active + d + opts.length) % opts.length;
      opts.forEach((o,i)=>o.classList.toggle('is-active', i===active));
      opts[active].scrollIntoView({ block: 'nearest' });
    }

    if(input){
      let t;
      input.addEventListener('input', () => { clearTimeout(t); t = setTimeout(onInput, 120); });
      input.addEventListener('focus', onInput);
      input.addEventListener('keydown', (e) => {
        if(e.key === 'ArrowDown'){ e.preventDefault(); move(1); }
        else if(e.key === 'ArrowUp'){ e.preventDefault(); move(-1); }
        else if(e.key === 'Enter'){
          const opts = box.querySelectorAll('.kb-result');
          if(active >= 0 && opts[active]) window.location.href = opts[active].getAttribute('href');
        } else if(e.key === 'Escape'){ box.classList.remove('is-open'); input.setAttribute('aria-expanded','false'); }
      });
      document.addEventListener('click', (e) => {
        if(!document.getElementById('kb-search').contains(e.target)){ box.classList.remove('is-open'); input.setAttribute('aria-expanded','false'); }
      });
    }
  </script>
</BaseLayout>
