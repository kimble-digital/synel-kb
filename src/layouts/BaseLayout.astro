---
// src/layouts/BaseLayout.astro — Synel Knowledge Base
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Symon from '../components/Symon.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  siteName?: string;
  lang?: 'en' | 'fr';
}

const {
  title,
  description = 'Synel product knowledge base — setup guides, troubleshooting and how-tos for TimeLOG, Synergy, Sygma, access control and more.',
  canonicalUrl,
  siteName = 'Synel Knowledge Base',
  lang = 'en',
} = Astro.props;

const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalHref = canonicalUrl || Astro.url.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Symon />
  </body>
</html>
