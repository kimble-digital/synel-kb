[
  {
    "name": "articles",
    "type": "base",
    "schema": [
      {"name": "uid",          "type": "text",   "required": true,  "options": {"max": 12}},
      {"name": "title",        "type": "text",   "required": true,  "options": {"max": 255}},
      {"name": "category",     "type": "select", "required": true,  "options": {"maxSelect": 1, "values": ["Terminals & Devices","Access Control","Biometrics & Enrolment","Scheduling & Absence","Integrations & Payroll Export","Modules & Reporting","Software - TimeLOG Web / Synergy WF","Software - TimeLOG Pro / Legacy","EPOS & Cashless","Account & Login","Networking & Infrastructure","Training Material","French Integrations","General / Uncategorised"]}},
      {"name": "body_html",    "type": "editor", "required": true},
      {"name": "product",      "type": "text",   "required": false},
      {"name": "quality",      "type": "select", "required": false, "options": {"maxSelect": 1, "values": ["good","thin"]}},
      {"name": "also_covers",  "type": "text",   "required": false},
      {"name": "status",       "type": "select", "required": true,  "options": {"maxSelect": 1, "values": ["published","needs_review","draft","archived"]}},
      {"name": "images",       "type": "file",   "required": false, "options": {"maxSelect": 10, "mimeTypes": ["image/png","image/jpeg","image/webp","image/gif"]}}
    ],
    "listRule": "status = 'published'",
    "viewRule": "status = 'published'",
    "indexes": ["CREATE UNIQUE INDEX idx_articles_uid ON articles (uid)", "CREATE INDEX idx_articles_category ON articles (category)"]
  }
]
